-- lib-cli-router: modules this package provides (entry defaults to
-- src/index.hnl; N modules resolve to src/<name>/index.hnl).
{ modules: ["cli-router"], deps: { mri: "branch:main", proc: "branch:main", route: "branch:main", stdio: "branch:main" }, name: "cli-router", description: "CLI ergonomics layer over lib-route + lib-mri: nested route-map -> argv dispatch ({code,out}), :param/*splat tokens, mri flag parsing into handler ctx.state, usage() help rendering, and a run() shell wrapper. Pure-handl; run() defaults argv to proc.argv() and exits via proc.exit (P-012).", license: "MIT", keywords: ["cli", "argv", "router", "dispatch", "usage", "stdlib", "handl"], homepage: "https://github.com/handl-lang/lib-cli-router" }
